{
  "name": "xssential",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @xssential/desktop dev",
    "dev:web": "pnpm --filter @xssential/web dev",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @xssential/desktop build",
    "build:web": "pnpm --filter @xssential/web build",
    "dist:mac": "pnpm --filter @xssential/desktop dist:mac",
    "dist:win": "pnpm --filter @xssential/desktop dist:win",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
